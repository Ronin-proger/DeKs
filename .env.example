OBSIDIAN_TRY_INSECURE=
OBSIDIAN_API_KEY=
OBSIDIAN_VAULT_PATH=

OLLAMA_BASE_URL=
OLLAMA_CHAT_MODEL=
OLLAMA_EMBED_MODEL=
